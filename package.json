{
  "name": "lucknow-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prebuild && tsx server.ts --dev",
    "prebuild": "node -e \"process.exit(require('fs').existsSync('public/hlod/hlod_manifest.json') ? 0 : 1)\" || npm run bake",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "transport": "tsx --max-old-space-size=8192 scripts/build_transportation.ts",
    "bake": "tsx --max-old-space-size=8192 scripts/bake_hlod.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "serve": "npm run build && npm run start",
    "suppress": "tsx --max-old-space-size=8192 scripts/suppress_conflicts.ts",
    "vegetation": "tsx --max-old-space-size=8192 scripts/place_vegetation.ts",
    "audit:landmarks": "tsx scripts/audit_landmarks.ts",
    "smoke": "node scripts/smoke_test.mjs",
    "live": "npm run build && node scripts/build_vercel.mjs app https://terralyt-six.vercel.app https://terralyt-data.vercel.app && vercel deploy --prebuilt --prod --yes --archive=tgz",
    "live:data": "npm run build && node scripts/build_vercel.mjs data && cd deploy-data && vercel deploy --prebuilt --prod --yes --archive=tgz"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
