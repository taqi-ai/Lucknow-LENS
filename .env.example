# Lucknow Lens — environment configuration
# Copy to .env and fill in. Never commit .env.

# Server port (default: 3000)
PORT=3000

# ── AI City Analyst ────────────────────────────────────────────────────────
# Optional. Without it, /api/analyst falls back to deterministic rule-based answers.
GEMINI_API_KEY=

# ── Live flights (OpenSky Network) ─────────────────────────────────────────
# Optional. Anonymous access works out of the box but has a low daily quota.
# A free account at https://opensky-network.org raises it substantially.
OPENSKY_USER=
OPENSKY_PASS=

# ── Live trains (RailRadar) ────────────────────────────────────────────────
# Required for the railway layer. Indian live-train APIs have no free anonymous
# tier, so without this key the layer reports "provider unavailable" rather than
# showing fabricated train positions.
RAILRADAR_API_KEY=
# Override only if your plan uses a different host.
RAILRADAR_API_BASE=

# ── Live traffic (TomTom Traffic Incidents) ────────────────────────────────
# Optional. Without it, the traffic layer reports "provider unavailable"
# rather than showing fabricated incidents. Get a free key at
# https://developer.tomtom.com/
TOMTOM_API_KEY=

# ── Live news (GDELT Project) ──────────────────────────────────────────────
# No key required — GDELT's DOC 2.0 API is free and keyless. Note: some
# network environments block GDELT's IP range; if so the news layer reports
# "unavailable" honestly rather than fabricating headlines.
